{
  "name": "@brandon.zylstra/zsh-wasm",
  "version": "0.6.0",
  "description": "Zsh 5.9 compiled to WebAssembly \u2014 run a real zsh interpreter in the browser",
  "type": "module",
  "main": "zsh-runtime.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./zsh-runtime.js"
    }
  },
  "files": [
    "index.d.ts",
    "zsh-runtime.js",
    "zsh-worker.js",
    "zsh.js",
    "zsh.wasm",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "prepublishOnly": "node check-built.js"
  },
  "keywords": [
    "zsh",
    "shell",
    "wasm",
    "webassembly",
    "browser",
    "emscripten"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonzylstra/zsh-wasm.git"
  },
  "sideEffects": [
    "zsh.js"
  ]
}
