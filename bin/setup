#!/usr/bin/env bash
# One-time initial setup for building zsh-wasm.
# Run from the project root after downloading the zsh source (see README step 1).
# Idempotent — safe to run again if a previous attempt was incomplete.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STUB="$ROOT/ncurses-stub"
BUILD="$ROOT/build-zsh"

# 🚨 THE ZSH RELEASE IS NAMED ONCE, HERE. It used to be spelled into twenty-six
# paths across this script and bin/setup, so moving to a new release meant a
# find-and-replace that had to be right everywhere at once — and a missed one
# does not fail loudly, it points a compiler at a directory that is not there.
# Override for a side-by-side build:  ZSH_RELEASE=5.9.1 bin/build
ZSH_RELEASE="${ZSH_RELEASE:-5.9.2}"
ZSH_SRC="$ROOT/zsh-$ZSH_RELEASE"
SRC="$ZSH_SRC"

if [[ ! -d "$SRC" ]]; then
    echo "Error: $SRC not found. Download it first:"
    echo "  curl -L -O https://www.zsh.org/pub/zsh-$ZSH_RELEASE.tar.xz && tar xf zsh-$ZSH_RELEASE.tar.xz"
    echo
    echo "zsh.org/pub/ keeps only the CURRENT release; anything older is under pub/old/:"
    echo "  curl -L -O https://www.zsh.org/pub/old/zsh-$ZSH_RELEASE.tar.xz"
    exit 1
fi

echo "==> building ncurses stub"
if [[ -f "$STUB/lib/libncurses.a" ]]; then
    echo "    already built, skipping"
else
    cd "$STUB"
    emcc -c ncurses_stub.c -o ncurses_stub.o
    emar rcs lib/libncurses.a ncurses_stub.o
    cd "$ROOT"
fi

echo "==> patching zsh source"
# zutil.mdd: remove spurious moddeps on zsh/complete
if grep -q 'moddeps="zsh/complete"' "$SRC/Src/Modules/zutil.mdd" 2>/dev/null; then
    sed -i '' '/^moddeps="zsh\/complete"$/d' "$SRC/Src/Modules/zutil.mdd"
    echo "    zutil.mdd: removed moddeps line"
else
    echo "    zutil.mdd: already patched"
fi
# zutil.c: inline the one call that depended on zsh/complete
if grep -q 'set_list_array(args\[1\], zstyle_list)' "$SRC/Src/Modules/zutil.c"; then
    sed -i '' \
        's/set_list_array(args\[1\], zstyle_list);/setaparam(args[1], zlinklist2array(zstyle_list, 1));/' \
        "$SRC/Src/Modules/zutil.c"
    echo "    zutil.c: inlined set_list_array call"
else
    echo "    zutil.c: already patched"
fi

# exec.c: add no-fork fallback for $() command substitution in wasm
if grep -q '__EMSCRIPTEN__' "$SRC/Src/exec.c"; then
    echo "    exec.c: already patched for wasm command substitution"
else
    python3 - "$SRC/Src/exec.c" << 'PYEOF'
import sys
with open(sys.argv[1]) as f:
    src = f.read()
OLD_ZFORK = (
    '    if (pid == -1) {\n'
    '\tzerr("fork failed: %e", errno);\n'
    '\treturn -1;\n'
    '    }'
)
NEW_ZFORK = (
    '    if (pid == -1) {\n'
    '#ifdef __EMSCRIPTEN__\n'
    '\tif (errno == ENOSYS)\n'
    '\t    return -1;\t/* fork() unavailable in wasm \xe2\x80\x94 caller handles this silently */\n'
    '#endif\n'
    '\tzerr("fork failed: %e", errno);\n'
    '\treturn -1;\n'
    '    }'
)
if OLD_ZFORK in src:
    src = src.replace(OLD_ZFORK, NEW_ZFORK, 1)
elif NEW_ZFORK in src:
    pass  # already patched
else:
    print('ERROR: could not find zfork error block in exec.c', file=__import__('sys').stderr)
    raise SystemExit(1)
OLD = (
    '    if ((cmdoutpid = pid = zfork(NULL)) == -1) {\n'
    '\t/* fork error */\n'
    '\tzclose(pipes[0]);\n'
    '\tzclose(pipes[1]);\n'
    '\terrflag |= ERRFLAG_ERROR;\n'
    '\tcmdoutpid = 0;\n'
    '\tchild_unblock();\n'
    '\treturn NULL;\n'
    '    } else if (pid) {'
)
NEW = (
    '    if ((cmdoutpid = pid = zfork(NULL)) == -1) {\n'
    '\t/* fork error */\n'
    '#ifdef __EMSCRIPTEN__\n'
    '\t/* Wasm: fork() is unavailable; run the substituted command in-process.\n'
    '\t * Variable assignments inside $() leak to the parent shell.\n'
    '\t * Output larger than the pipe buffer may deadlock; both are acceptable\n'
    '\t * for the script workloads zsh-wasm targets. */\n'
    '\t{\n'
    '\t\tLinkList retval;\n'
    '\t\tint oldout = dup(1);\n'
    '\t\tif (oldout == -1 || dup2(pipes[1], 1) == -1) {\n'
    '\t\t\tif (oldout != -1) close(oldout);\n'
    '\t\t\tzclose(pipes[0]);\n'
    '\t\t\tzclose(pipes[1]);\n'
    '\t\t\terrflag |= ERRFLAG_ERROR;\n'
    '\t\t\tcmdoutpid = 0;\n'
    '\t\t\tchild_unblock();\n'
    '\t\t\treturn NULL;\n'
    '\t\t}\n'
    '\t\tzclose(pipes[1]);\n'
    '\t\terrflag = 0;\n'
    '\t\tcmdoutpid = 0;\n'
    '\t\tcmdpush(CS_CMDSUBST);\n'
    '\t\texecode(prog, 0, 1, "cmdsubst");\n'
    '\t\tcmdpop();\n'
    '\t\tcmdoutval = lastval;\n'
    '\t\tfflush(stdout);\n'
    '\t\tdup2(oldout, 1);\n'
    '\t\tclose(oldout);\n'
    '\t\tchild_unblock();\n'
    '\t\terrflag = 0;\t/* discard fork-failure errflag; errors are in cmdoutval */\n'
    '\t\tretval = readoutput(pipes[0], qt, NULL);\n'
    '\t\tfdtable[pipes[0]] = FDT_UNUSED;\n'
    '\t\tlastval = cmdoutval;\n'
    '\t\treturn retval;\n'
    '\t}\n'
    '#endif\n'
    '\tzclose(pipes[0]);\n'
    '\tzclose(pipes[1]);\n'
    '\terrflag |= ERRFLAG_ERROR;\n'
    '\tcmdoutpid = 0;\n'
    '\tchild_unblock();\n'
    '\treturn NULL;\n'
    '    } else if (pid) {'
)
if OLD not in src:
    print('ERROR: could not find fork-error block in exec.c', file=__import__('sys').stderr)
    raise SystemExit(1)
with open(sys.argv[1], 'w') as f:
    f.write(src.replace(OLD, NEW, 1))
PYEOF
    echo "    exec.c: patched for wasm command substitution"
fi

# exec.c: run pipeline stages in-process when fork() is unavailable.
#
# Without this, `a | b` produces nothing at all: the stage that would have been
# a child process fails to fork and the shell takes the fatal error path.  The
# patch below makes each stage run in the current shell, one after another,
# with its output going to a temp file that the next stage reads.  It mirrors
# what the command-substitution patch above already does for $( ).
if grep -q 'zsh_wasm_nofork' "$SRC/Src/exec.c"; then
    echo "    exec.c: already patched for wasm pipelines"
else
    python3 - "$SRC/Src/exec.c" << 'PYEOF'
import re
import sys

# Every literal below is plain ASCII on purpose: the file already contains
# non-ASCII comment text, and matching it through a shell heredoc is a good way
# to produce a patch that silently fails to apply.

path = sys.argv[1]
with open(path) as source_file:
    source = source_file.read()

def replace_once(source, old, new, description):
    if new in source:
        return source          # already applied
    if old not in source:
        print('ERROR: could not find %s in exec.c' % description, file=sys.stderr)
        raise SystemExit(1)
    return source.replace(old, new, 1)

# 1. A flag recording that fork() really is unavailable (rather than having
#    failed for some other reason), set the first time zfork() sees ENOSYS.
OLD_FLAG = (
    '/* fork and set limits */\n'
    '\n'
    '/**/\n'
    'static pid_t\n'
    'zfork(struct timeval *tv)\n'
)
NEW_FLAG = (
    '#ifdef __EMSCRIPTEN__\n'
    '/*\n'
    ' * Set once fork() has been seen to fail with ENOSYS, which under wasm means\n'
    ' * it is missing rather than merely out of resources.  Pipeline stages check\n'
    ' * this before falling back to running in the current shell.\n'
    ' */\n'
    'static int zsh_wasm_nofork = 0;\n'
    '#endif\n'
    '\n'
    '/* fork and set limits */\n'
    '\n'
    '/**/\n'
    'static pid_t\n'
    'zfork(struct timeval *tv)\n'
)
source = replace_once(source, OLD_FLAG, NEW_FLAG, 'the zfork definition')

# The trailing comment on the return is matched loosely: it contains an em dash
# that is awkward to reproduce byte-for-byte from here.
ENOSYS_PATTERN = re.compile(
    r'#ifdef __EMSCRIPTEN__\n'
    r'\tif \(errno == ENOSYS\)\n'
    r'\t    return -1;(?P<comment>[^\n]*)\n'
    r'#endif\n')

def brace_enosys(match):
    return ('#ifdef __EMSCRIPTEN__\n'
            '\tif (errno == ENOSYS) {\n'
            '\t    zsh_wasm_nofork = 1;\n'
            '\t    return -1;' + match.group('comment') + '\n'
            '\t}\n'
            '#endif\n')

source, substitutions = ENOSYS_PATTERN.subn(brace_enosys, source, count=1)
if not substitutions:
    print('ERROR: could not find the zfork ENOSYS fallback in exec.c', file=sys.stderr)
    raise SystemExit(1)

# 2. The channel between two stages.  A real pipe cannot be used: Emscripten's
#    pipe never reports end-of-file, so a stage reading a drained pipe gets
#    EAGAIN forever instead of EOF.
OLD_STAGEFILE = (
    '/* execute pipeline.  This function assumes the `pline\' is not NULL. */\n'
)
NEW_STAGEFILE = (
    '#ifdef __EMSCRIPTEN__\n'
    '/*\n'
    ' * Create the channel carrying one pipeline stage\'s output to the next.\n'
    ' *\n'
    ' * Wasm has no fork(), so stages run one after another in this shell (see the\n'
    ' * fallbacks in execcmd_exec) instead of concurrently.  A real pipe cannot\n'
    ' * carry the data between them: Emscripten\'s pipe reports EAGAIN rather than\n'
    ' * end-of-file once drained, so the reading stage would never see EOF.  A temp\n'
    ' * file is correct for sequential stages: the writer has finished by the time\n'
    ' * the reader starts, so the reader sees the whole output and then a normal\n'
    ' * EOF.  The file is unlinked at once and lives only as long as the two\n'
    ' * descriptors do.\n'
    ' */\n'
    '\n'
    'static int\n'
    'stagefile(int *pp)\n'
    '{\n'
    '    char *name;\n'
    '    int readfd, writefd;\n'
    '\n'
    '    if ((writefd = gettempfile(NULL, 1, &name)) < 0) {\n'
    '\tzerr("can\'t create temp file for pipeline: %e", errno);\n'
    '\treturn -1;\n'
    '    }\n'
    '    readfd = open(name, O_RDONLY | O_NOCTTY);\n'
    '    unlink(name);\n'
    '    if (readfd < 0) {\n'
    '\tzerr("can\'t open temp file for pipeline: %e", errno);\n'
    '\tclose(writefd);\n'
    '\treturn -1;\n'
    '    }\n'
    '    pp[0] = movefd(readfd);\n'
    '    pp[1] = movefd(writefd);\n'
    '    return 0;\n'
    '}\n'
    '#endif /* __EMSCRIPTEN__ */\n'
    '\n'
    '/* execute pipeline.  This function assumes the `pline\' is not NULL. */\n'
)
source = replace_once(source, OLD_STAGEFILE, NEW_STAGEFILE, 'the execpline2 comment')

# 3. execpline2: use the temp-file channel and hand the stage its own copy of
#    the write end.
OLD_PIPE = (
    '\tif (mpipe(pipes) < 0) {\n'
    '\t    /* FIXME */\n'
    '\t}\n'
    '\n'
    '\taddfilelist(NULL, pipes[0]);\n'
    '\texeccmd_exec(state, &eparams, input, pipes[1], how, 0, pipes[0]);\n'
    '\tzclose(pipes[1]);\n'
)
NEW_PIPE = (
    '#ifdef __EMSCRIPTEN__\n'
    '\tif (stagefile(pipes) < 0) {\n'
    '\t    /* FIXME */\n'
    '\t}\n'
    '#else\n'
    '\tif (mpipe(pipes) < 0) {\n'
    '\t    /* FIXME */\n'
    '\t}\n'
    '#endif\n'
    '\n'
    '\taddfilelist(NULL, pipes[0]);\n'
    '#ifdef __EMSCRIPTEN__\n'
    '\t/* The stage runs in this shell, and addfd() consumes whichever\n'
    '\t * descriptor it is handed: it dup2()s that fd onto stdout and closes\n'
    '\t * it.  Pass a copy, so the write end below is unambiguously ours to\n'
    '\t * close once the stage has finished writing. */\n'
    '\t{\n'
    '\t    int stageout = movefd(dup(pipes[1]));\n'
    '\n'
    '\t    execcmd_exec(state, &eparams, input, stageout, how, 0, pipes[0]);\n'
    '\t}\n'
    '#else\n'
    '\texeccmd_exec(state, &eparams, input, pipes[1], how, 0, pipes[0]);\n'
    '#endif\n'
    '\tzclose(pipes[1]);\n'
)
source = replace_once(source, OLD_PIPE, NEW_PIPE, 'the execpline2 pipe setup')

# 4. execcmd_exec, first fork site: reached for every stage that is not the
#    last one, before we know what kind of command it is.
OLD_FORK1 = (
'\tswitch (execcmd_fork(state, how, type, varspc, &filelist,\n'
'\t\t\t     text, oautocont, close_if_forked)) {\n'
'\tcase -1:\n'
'\t    goto fatal;\n'
'\tcase 0:\n'
'\t    break;\n'
'\tdefault:\n'
'\t    return;\n'
'\t}\n'
'\tlast1 = forked = 1;\n'
)
NEW_FORK1 = (
'\tswitch (execcmd_fork(state, how, type, varspc, &filelist,\n'
'\t\t\t     text, oautocont, close_if_forked)) {\n'
'\tcase -1:\n'
'#ifdef __EMSCRIPTEN__\n'
'\t    if (zsh_wasm_nofork) {\n'
'\t\t/* Wasm: fork() is unavailable, so run this pipeline stage in the\n'
'\t\t * current shell rather than a child.  addfd() below saves fds 0\n'
'\t\t * and 1 and fixfds() restores them afterwards, so the pipeline\n'
'\t\t * redirection does not escape this command.  Stages therefore run\n'
'\t\t * one after another instead of concurrently, and share the\n'
'\t\t * shell\'s state: assignments made in a stage are visible to the\n'
'\t\t * rest of the script.  Both are the same trade-offs the command\n'
'\t\t * substitution fallback accepts. */\n'
'\t\tchild_unblock();\n'
'\t\terrflag &= ~ERRFLAG_ERROR;\n'
'\t\tlastval = old_lastval;\n'
'\t\tbreak;\t\t/* forked stays 0: this shell runs the command */\n'
'\t    }\n'
'#endif\n'
'\t    goto fatal;\n'
'\tcase 0:\n'
'\t    last1 = forked = 1;\n'
'\t    break;\n'
'\tdefault:\n'
'\t    return;\n'
'\t}\n'
)
source = replace_once(source, OLD_FORK1, NEW_FORK1, 'the early execcmd_fork call')

# 5. execcmd_exec, second fork site: reached once the command has been
#    identified.  Only a builtin or shell function can run in this shell; an
#    external command needs fork()+exec() and still takes the error path.
OLD_FORK2 = (
'\t    switch (execcmd_fork(state, how, type, varspc, &filelist,\n'
'\t\t\t\t text, oautocont, close_if_forked)) {\n'
'\t    case -1:\n'
'\t\tgoto fatal;\n'
'\t    case 0:\n'
'\t\tbreak;\n'
'\t    default:\n'
'\t\treturn;\n'
'\t    }\n'
'\t    forked = 1;\n'
)
NEW_FORK2 = (
'\t    switch (execcmd_fork(state, how, type, varspc, &filelist,\n'
'\t\t\t\t text, oautocont, close_if_forked)) {\n'
'\t    case -1:\n'
'#ifdef __EMSCRIPTEN__\n'
'\t\tif (zsh_wasm_nofork && (is_cursh || type == WC_SUBSH)) {\n'
'\t\t    /* See the matching fallback above.  Builtins, functions and\n'
'\t\t     * ( ... ) all have an in-process form; a real external\n'
'\t\t     * command needs fork()+exec() and still fails here. */\n'
'\t\t    child_unblock();\n'
'\t\t    errflag &= ~ERRFLAG_ERROR;\n'
'\t\t    lastval = old_lastval;\n'
'\t\t    break;\n'
'\t\t}\n'
'#endif\n'
'\t\tgoto fatal;\n'
'\t    case 0:\n'
'\t\tforked = 1;\n'
'\t\tbreak;\n'
'\t    default:\n'
'\t\treturn;\n'
'\t    }\n'
)
source = replace_once(source, OLD_FORK2, NEW_FORK2, 'the late execcmd_fork call')

with open(path, 'w') as source_file:
    source_file.write(source)
PYEOF
    echo "    exec.c: patched for wasm pipelines"
fi

echo "==> configuring"
if [[ -f "$BUILD/Makefile" ]]; then
    echo "    already configured (delete build-zsh/ to reconfigure from scratch)"
else
    mkdir -p "$BUILD"
    cd "$BUILD"
    emconfigure "$SRC/configure" \
        --build="$("$SRC/config.guess")" \
        --host=wasm32-unknown-emscripten \
        --disable-dynamic \
        --without-tcsetpgrp \
        --disable-dynamic-nss \
        CPPFLAGS="-I$STUB/include" \
        LDFLAGS="-L$STUB/lib" \
        LIBS="-lncurses" \
        CFLAGS="-Os"
    cd "$ROOT"
fi

echo "==> patching config.h"
"$ROOT/bin/patch-config"

echo "==> patching generated build files"
cd "$BUILD"
if grep -q '^ZSH_TERM_H = term.h' Config/defs.mk; then
    echo "    defs.mk: already patched"
else
    sed -i '' 's/^ZSH_TERM_H = $/ZSH_TERM_H = term.h/' Config/defs.mk
    echo "    defs.mk: patched"
fi
if [[ -f Src/zshterm.h ]] && grep -q 'term.h' Src/zshterm.h; then
    echo "    zshterm.h: already exists"
else
    printf '#include <term.h>\n' > Src/zshterm.h
    echo "    zshterm.h: created"
fi

echo "==> configuring modules"
# Disable ZLE/completion — require a real terminal and add ~350KB to the binary
sed -i '' -E \
    -e 's/^(name=zsh\/(zle|compctl|complete|complist|computil|zleparameter) .*)link=static/\1link=no/' \
    -e 's/^(name=zsh\/(zle|compctl|complete|complist|computil|zleparameter) .*)load=yes/\1load=no/' \
    config.modules
# Enable zsh/files (file ops without fork), zsh/stat (file metadata for ls -l),
# zsh/regex (=~ operator), and zsh/mathfunc (sin, cos, log, sqrt, etc.)
sed -i '' -E \
    -e 's/^(name=zsh\/(files|stat|regex|mathfunc) .*)link=no/\1link=static/' \
    -e 's/^(name=zsh\/(files|stat|regex|mathfunc) .*)load=no/\1load=yes/' \
    config.modules
# Register zsh/sed (disabled by default; enabled at build time with --with-sed).
# The module descriptor lives in sed-src/; bin/build --with-sed copies it to the
# zsh source tree before compiling.  We just need the entry in config.modules so
# that bin/build can flip link=static when requested.
if grep -q '^name=zsh/sed ' config.modules; then
    echo "    config.modules: zsh/sed already present"
else
    python3 -c "
import sys
lines = open('config.modules').readlines()
out = []
for line in lines:
    out.append(line)
    if line.startswith('name=zsh/net/socket '):
        out.append('name=zsh/sed modfile=Src/Modules/sed.mdd link=no auto=yes load=no\n')
open('config.modules', 'w').write(''.join(out))
"
    echo "    config.modules: added zsh/sed (disabled by default)"
fi
# Patch config.modules.sh so the zsh/sed entry survives a manual config.status run.
if grep -q 'zsh/sed' config.modules.sh; then
    echo "    config.modules.sh: zsh/sed already present"
else
    python3 -c "
import sys
lines = open('config.modules.sh').readlines()
insert = [
    'case \"\$userlist\" in\n',
    '  *\" zsh/sed \"*) grep \"^name=zsh/sed \" \${CONFIG_MODULES}.old;;\n',
    '  *) echo \"name=zsh/sed modfile=Src/Modules/sed.mdd link=no auto=yes load=no\";;\n',
    'esac\n',
]
out = []
for line in lines:
    if '*\" zsh/stat \"*) grep' in line:
        out.extend(insert)
    out.append(line)
open('config.modules.sh', 'w').write(''.join(out))
"
    echo "    config.modules.sh: added zsh/sed entry"
fi
# Register zsh/awk (disabled by default; enabled at build time with --with-awk).
if grep -q '^name=zsh/awk ' config.modules; then
    echo "    config.modules: zsh/awk already present"
else
    python3 -c "
import sys
lines = open('config.modules').readlines()
out = []
for line in lines:
    out.append(line)
    if line.startswith('name=zsh/net/socket '):
        out.append('name=zsh/awk modfile=Src/Modules/awk.mdd link=no auto=yes load=no\n')
open('config.modules', 'w').write(''.join(out))
"
    echo "    config.modules: added zsh/awk (disabled by default)"
fi
# Patch config.modules.sh so the zsh/awk entry survives a manual config.status run.
if grep -q 'zsh/awk' config.modules.sh; then
    echo "    config.modules.sh: zsh/awk already present"
else
    python3 -c "
import sys
lines = open('config.modules.sh').readlines()
insert = [
    'case \"\$userlist\" in\n',
    '  *\" zsh/awk \"*) grep \"^name=zsh/awk \" \${CONFIG_MODULES}.old;;\n',
    '  *) echo \"name=zsh/awk modfile=Src/Modules/awk.mdd link=no auto=yes load=no\";;\n',
    'esac\n',
]
out = []
for line in lines:
    if '*\" zsh/stat \"*) grep' in line:
        out.extend(insert)
    out.append(line)
open('config.modules.sh', 'w').write(''.join(out))
"
    echo "    config.modules.sh: added zsh/awk entry"
fi
echo "    config.modules: done"

echo ""
echo "Setup complete. Run  bin/build  to compile and deploy."
